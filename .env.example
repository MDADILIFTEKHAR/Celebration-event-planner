# Celebration Event Planner AI - Environment Configuration Example
# Copy this file to .env to configure optional features.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI Provider Configuration
# The application functions completely with deterministic local intelligence.
# Providing an API key enables enhanced creative suggestions and conversational nuances.
AI_PROVIDER=none # Options: none, gemini, openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./celebration_planner.db
